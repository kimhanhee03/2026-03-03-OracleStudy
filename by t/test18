                                       ------ 캡슐화 (private , getter/setter)
      1) PL / SQL의 기초 
          => 프로시저를 만드는 언어 (기능 = 함수 = 재사용이 가능) 
               => 프로그램은 SQL문장으로 제작 : 명령어를 모아서 처리 
               => 속도가 빠르다 / 절대 지워지지 않는다 , 보안 
               => 단점 : 웹 개발자가 수정하기 어렵다 , 가독성 떨어진다 
          => FUNCTION : 리턴형이 있는 경우 (처리 결과값) 
          => PROCEDURE : 리턴형이 없는 경우 (void) 
          => TRIGGER : 자동화 처리 => 자바자체에 소스 코딩 
                              출고  = 재고 
                              입고  = 재고 
                                         ------ TRIGGER (같은 테이블에서는 사용할 수 없다) 
               ==> 맛집  (좋아요 , 찜)  ==> 좋아요 , 게시물 = 댓글 
          1. 형식 => C언어 
             DECLARE 
               => 선언부 : 변수 선언 
             BEGIN 
               => 구현부 : SQL문장으로 주로 사용 
             END;
              /
             1) 변수의 종류 
                 = 일반 변수 (스칼라 변수)
                     변수 데이터형(VARCHAR2,DATE, NUMBER,CLOB) 
                     ---------------
                     empno NUMBER(4)
                 = %TYPE : 실제 테이블의 컬럼의 데이터형을 가지고 온다 
                    변수 테이블명.컬럼명%TYPE => 가장 많이 사용되는 데이터형 
                           ------------------------- 한개씩 
                 = %ROWTYPE : 테이블에 있는 컬럼의 모든 데이터형을 읽는다 
                    변수 테이블명%ROWTYPE ==> 자바 (VO) 
                    => 한개의 테이블만 가능 
                 = RECORD : 테이블 여러개 연결 => JOIN , SUBQUERY 
                    => 사용자 정의 데이터형
                 ----------------------------------------------- ROW 한개의 데이터값만 받는다
                 = CURSOR : ROW여러개를 동시에 저장 => 자바로 전송 
                    => ResultSet / ArrayList 

          /* 
     PL/SQL = 변수 처리 방법 
*/
SET SERVEROUTPUT ON;
DECLARE
  -- 일반 변수 사용 
  vempno NUMBER(4);
  vename VARCHAR2(20);
  vjob VARCHAR2(20);
  vhiredate DATE;
BEGIN 
  -- 구현 
  SELECT empno,ename,job,hiredate
         INTO vempno,vename,vjob,vhiredate
  FROM emp 
  WHERE empno=7788;
  
  -- 변수 출력 
  -- System.out.println()
  DBMS_OUTPUT.PUT_LINE('***** 결과 *****');
  DBMS_OUTPUT.PUT_LINE('사번:'||vempno);
  DBMS_OUTPUT.PUT_LINE('이름:'||vename);
  DBMS_OUTPUT.PUT_LINE('직위:'||vjob);
  DBMS_OUTPUT.PUT_LINE('입사일:'||vhiredate);
  
END;
/

-- %TYPE : 가장 많이 사용되는 변수 => 실제 컬럼의 데이터형 읽기 
-- 사용 방식 : 테이블명.컬럼명%TYPE
/*
    ***1. DML (게시판) 
    ***2. JOIN / SUBQUERY (지니뮤직 , 멜론) 
    3. PROCEDURE 
    CUSTID  NOT NULL NUMBER(2)    
    NAME             VARCHAR2(40) 
    ADDRESS          VARCHAR2(50) 
    PHONE            VARCHAR2(20)
    
    main() DECLARE
    { BEGIN
        
    } END
*/
DECLARE
  -- 변수 선언 = 테이블에 존재하는 실제 컬럼의 데이터형 읽기 
  vcustid customer.custid%TYPE;
  vname customer.name%TYPE;
  vaddress customer.address%TYPE;
  vphone customer.phone%TYPE;
BEGIN
  -- 값을 채운다 
  SELECT custid,name,address,phone 
         INTO vcustid,vname,vaddress,vphone
  FROM customer
  WHERE custid=1;
  -- ROW단위 => 한개값만 받을 수 있다 
  -- 실제 화면에 출력 
  DBMS_OUTPUT.PUT_LINE('***** 결과 *****');
  DBMS_OUTPUT.PUT_LINE('번호:'||vcustid);
  DBMS_OUTPUT.PUT_LINE('이름:'||vname);
  DBMS_OUTPUT.PUT_LINE('주소:'||vaddress);
  DBMS_OUTPUT.PUT_LINE('전화:'||vphone);
END;
/

-- 한개의 테이블의 컬럼 전체 데이터형 읽기 => %ROWTYPE
-- 변수 테이블명%ROWTYPE ==> 구조체 => 클래스 
DECLARE
  vemp emp%ROWTYPE;
BEGIN
  -- 7900에 해당되는 ROW전체값을 받는다 
  SELECT * INTO vemp
  FROM emp
  WHERE empno=&사번;
  
  -- 출력 
  DBMS_OUTPUT.PUT_LINE('***** 결과 *****');
  DBMS_OUTPUT.PUT_LINE('사번:'||vemp.empno);
  DBMS_OUTPUT.PUT_LINE('이름:'||vemp.ename);
  DBMS_OUTPUT.PUT_LINE('직위:'||vemp.job);
  DBMS_OUTPUT.PUT_LINE('입사일:'||vemp.hiredate);
  DBMS_OUTPUT.PUT_LINE('급여:'||vemp.sal);
  DBMS_OUTPUT.PUT_LINE('부서번호:'||vemp.deptno);
END;
/
-- 사용자 정의 데이터형 RECORD => JOIN ==> DBA 
-- %TYPE / CURSOR 
/*
    형식) 
         => 자바의 VO 
         => TYPESCRIPT : interface 
         TYPE record명 IS RECORD(
           변수 설정 
         );
         RECORD 변수 선언  => ROW 1개만 받을 수 있다 
*/
/*
   class A
   
   A a;
*/
DECLARE
  -- RECORD 선언 
  TYPE empDept IS RECORD(
     empno emp.empno%TYPE,
     ename emp.ename%TYPE,
     job emp.job%TYPE,
     hiredate emp.hiredate%TYPE,
     sal emp.sal%TYPE,
     dname dept.dname%TYPE,
     loc dept.loc%TYPE,
     grade salgrade.grade%TYPE
  );
  -- RECORD 변수 선언 
  ed empDept;
  -- String name=aaa bbb ccc ddd
BEGIN
  -- 데이터값 채우기 => INNER JOIN (교집합) => ANSI
  SELECT empno,ename,job,hiredate,sal,dname,loc,grade
         INTO ed
  FROM emp JOIN dept ON emp.deptno=dept.deptno
  JOIN salgrade 
  ON sal BETWEEN losal AND hisal
  WHERE empno=&사번;
  
  DBMS_OUTPUT.PUT_LINE('***** 결과 *****');
  DBMS_OUTPUT.PUT_LINE('사번:'||ed.empno);
  DBMS_OUTPUT.PUT_LINE('이름:'||ed.ename);
  DBMS_OUTPUT.PUT_LINE('직위:'||ed.job);
  DBMS_OUTPUT.PUT_LINE('입사일:'||ed.hiredate);
  DBMS_OUTPUT.PUT_LINE('급여:'||ed.sal);
  DBMS_OUTPUT.PUT_LINE('부서명:'||ed.dname);
  DBMS_OUTPUT.PUT_LINE('근무지:'||ed.loc);
  DBMS_OUTPUT.PUT_LINE('등급:'||ed.grade);
END;
/
