-- IF ~ ELSE => true/false => 수행을 다르게 한다 
/*
    IF 조건 THEN 처리문장 
    ELSE 처리문장 
    END IF;
*/
DECLARE
  vename emp.ename%TYPE;
  vsal emp.sal%TYPE;
  vcomm emp.comm%TYPE;
  vempno emp.empno%TYPE:=&empno;
BEGIN
   SELECT ename,sal,comm INTO vename,vsal,vcomm
   FROM emp
   WHERE empno=vempno;
   -- NULL 값이면 => ELSE 
   IF vcomm>0 THEN 
     DBMS_OUTPUT.PUT_LINE(vename||'사원의 급여는 '||vsal||'이고 성과급은 '||vcomm||'입니다');
   ELSE
     DBMS_OUTPUT.PUT_LINE(vename||'사원의 급여는 '||vsal||'이고 성과급은 없습니다');
   END IF;
END;
/
/*
    조건문 
      단일 
         IF 조건 THEN 처리문장 
         END IF;
      다중 
         IF 조건 THEN 처리문장 
         ELSIF 조건 THEN 처리문장 
         ELSIF 조건 THEN 처리문장 
         ..
         ELSE 처리문장 
         END IF;
         
         CASE 값 
          WHEN 조건 THEN 값
          WHEN 조건 THEN 값
          WHEN 조건 THEN 값
          ELSE 값 
          END;
      선택 
         IF 조건 THEN 처리문장 
         ELSE 처리문장 
         END IF;
*/
/*
    반복문 
      1. 기본 LOOP 
         형식)
            LOOP 
              처리문장 
              처리문장 => 반복으로 수행되는 문장 
              EXIT[조건] => 종료 => do~while
            END LOOP;
              
      2. WHILE 
         형식) 
               WHILE 조건 LOOP 
                  처리문장 
                  처리문장 
                  ...
                END LOOP;
      ***3. FOR 
         형식) 
                예)
                   FOR i IN 1..9 LOOP  =>  1,2,3,....
                   FOR i IN REVERSE 1..9 LOOP  => 9 8 7...
                FOR 변수 IN start..end LOOP
                    처리문장 
                    ..
                END LOOP;
                
                FOR 변수 IN REVERSE start..end LOOP
                    처리문장 
                    ..
                END LOOP;
    => Function / Trigger / Procedure => 제작하지 않으면 쓸 일이 없다
    => CURSOR 
    => 함수 / 트리거 
*/
-- LOOP (do~while)
DECLARE
  sno NUMBER:=1; -- int i=1
  eno NUMBER:=10; 
BEGIN 
  LOOP 
   -- 반복문장 수행 
   DBMS_OUTPUT.PUT_LINE(sno);
   -- 증가값 i++
   sno:=sno+1;
   -- 종료 
   EXIT WHEN sno>eno;
   END LOOP;
END;
/
-- WHILE 
/*
   WHILE 조건 LOOP 
     반복 수행문장 
     ..
   END LOOP
   
   값을 대입  변수:=값 
   sno:=sno+1  => sno++
*/
DECLARE
   no NUMBER:=1;
BEGIN
   WHILE no<=10 LOOP
     DBMS_OUTPUT.PUT(no||' ');
     no:=no+1;
   END LOOP;
   DBMS_OUTPUT.NEW_LINE;
   --DBMS_OUTPUT.PUT('Hello ');
   --DBMS_OUTPUT.PUT('Oracle');
   --DBMS_OUTPUT.NEW_LINE;
END;
/
-- FOR 
DECLARE
BEGIN
  FOR i IN 1..10 LOOP
    DBMS_OUTPUT.PUT(i||' ');
  END LOOP;
  DBMS_OUTPUT.NEW_LINE;
END;
/
-- CURSOR => 데이터를 모아서 출력 
DECLARE
BEGIN
  FOR i IN REVERSE 1..10 LOOP
    DBMS_OUTPUT.PUT(i||' ');
  END LOOP;
  DBMS_OUTPUT.NEW_LINE;
END;
/

-- 1~100까지 짝수합 / 홀수합 / 총합 
DECLARE
    total NUMBER:=0;
    even NUMBER:=0;
    odd NUMBER:=0;
BEGIN
    FOR i IN 1..100 LOOP
      total:=total+i;
      IF MOD(i,2)=0 THEN 
       even:=even+i;
      ELSE
       odd:=odd+i;
      END IF;
    END LOOP;
    DBMS_OUTPUT.PUT_LINE('1~100 총합:'||total);
    DBMS_OUTPUT.PUT_LINE('1~100 짝수합:'||even);
    DBMS_OUTPUT.PUT_LINE('1~100 홀수합:'||odd);
END;
/
-- DECLARE : 선언부 = 재사용 할 수 없다 
-- CREATE FUNCTION / CREATE TRIGGER / CREATE PROCEDURE
/*
    반복문 => 여러개의 ROW를 출력 할때 사용 
    
    CURSOR : ROW 여러개를 저장하는 공간 
    1. 커서 선언 
       CURSOR 커서명 IS 
         SELECT ~~
    2. 커서 열기
       OPEN 커서명 
    3. 커서안에 데이터를 읽기 (추출) 
       FETCH 
    4. 출력 
       DBMS_OUTPUT.PUT_LINE 
    5. 커서 닫기 
       CLOSE 커서명
*/
DECLARE
  vemp emp%ROWTYPE;
  CURSOR cur IS 
    SELECT * FROM emp; -- 커서 선언 
BEGIN 
  -- 커서 열기 
  OPEN cur;
  -- FETCH : 데이터 추출 
  LOOP
    FETCH cur INTO vemp;
    -- 종료 시점
    EXIT WHEN cur%NOTFOUND; -- 데이터가 없을때 까지 출력 
    -- 출력 
    DBMS_OUTPUT.PUT_LINE(vemp.empno||' '||vemp.ename||' '||vemp.job);
  END LOOP;
  CLOSE cur;
END;
/
-- FOR 
DECLARE
 vemp emp%ROWTYPE;
 CURSOR cur IS 
   SELECT * FROM emp;
BEGIN
 FOR vemp IN cur LOOP
  DBMS_OUTPUT.PUT_LINE(vemp.empno||' '||vemp.ename||' '||vemp.job);
 END LOOP;
END;
/

/*
    PL/SQL문법 
     => SQL문장을 그대로 사용 / 연산자 / 내장 함수 
     => 문법 사항 
     선언부 
     DECLARE 
     CREATE FUNCTION func_name(매개변수...)
     IS 
      선언부 => 지역변수 
     CREATE PROCEDURE proc_name(매개변수...)
     IS 
      선언부 => 지역변수
     CREATE TRIGGER trigger_name
     IS 
      선언부 => 지역변수 
     구현부 
     BEGIN
       SQL => 제어문 (수행 => SQL문장)
       => INTO : 변수값을 받는 경우 
       => SELECT : 화면 출력 => 변수로 사용되는 것이 아니다 
     END;
     
     변수 : %TYPE , 스칼라 변수 , CURSOR 
     제어문 : IF / IF ~ ELSE / CASE / FOR
     형식)
          --------------------
           IF 조건 THEN 
             처리문장 
             처리문장
             처리문장
           END IF; 
           
           IF 조건 THEN
             처리문장 
           ELSE
             처리문장 
           END IF;
           
           CASE 값  => switch(값) 
            WHEN 조건 THEN 값
            WHEN 조건 THEN 값
            WHEN 조건 THEN 값
            ...
            ELSE 값
           END;
           
           입고 : 이미 저장된 상품 => UPDATE 수량 증가 
                 없는 상품 => INSERT
           출고 : 남아 있는 상품 => UPDATE 
                 상품이 없는 경우 => DELETE
          --------------------------- TRIGGER  
           FOR 변수 IN CURSOR LOOP
             반복처리문장  ==> for-each
           END LOOP
          ---------------------------- PROCEDURE 
      PL/SQL의 문법 
*/

*/
