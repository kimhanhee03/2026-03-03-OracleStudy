/*
      SELECT 문장 142page 
      1. 데이터 검색 
      2. 형식 / 순서 
         -----------------------------------------------
         SELECT *(ALL)|원하는 컬럼지정 column_list 
         FROM table_name 
        ------------------------------------------------ 필수 
         [
             WHERE 조건(연산자) 
             GROUP BY 그룹컬럼
             HAVING 그룹 조건 =====> GROUP BY 가 있는 경우만 사용 가능
             ORDER BY 정렬컬럼 (ASC|DESC)
                                                 | 내림차순  
                                          |올림차순 
         ]
       3. 주의점 
           = 대소문자 구분이 없다 Select/select/SELECT 
              (약속 => 키워드는 대문자로 한다) 
           = 실제 저장된 데이터는 대소문자를 구분한다 (KING => king)
           = 문장이 종료가 되면 ;을 사용한다 
              => 자바에서는 자동으로 ;이 추가됨 
           = 문자,날짜는 반드시 ''을 사용한다 

       4. 문자열 형식으로만 되어 있다 
       5. 날짜 형식 => 'YY/MM/DD' => '26/04/13'
       6. 중복없는 데이터 
          DISTINCT column
       7. 문자열 결합  ||
          ename||'는 급여가 '||sal||'입니다'  => ||,&&(X)  => OR , AND
       8. & ==> Scanner ==> 크롤링 (이미지 => http~~ & => ^) 
       9. FROM emp
       => 1 SELECT ~
            2 ===> ;이 없는 경우 
*/
-- SELECT * FROM emp
/*
   사원 정보 => 한사원에 대한 정보 => 인원수 14명 
   EMPNO     NOT NULL NUMBER(4) : 사번                                                                                                                                   
   ENAME      VARCHAR2(10) : 이름                                                                                                                                          
   JOB           VARCHAR2(9)  : 직위                                                                                                                                       
   MGR         NUMBER(4)      : 사수번호 (사번)                                                                                                                             
   HIREDATE   DATE        : 입사일                                                                                                                                    
   SAL      NUMBER(7,2)   : 급여                                                                                                                                          
   COMM    NUMBER(7,2)   : 성과급                                                                                                                                            
   DEPTNO    NUMBER(2)    : 부서번호       

   -- 모든 사원의 정보를 가지고 온다 
SELECT *
FROM emp;
-- 원하는 데이터만 추출  (프로젝션) => column_list
-- 사번 , 이름 , 직위 , 입사일 , 급여 출력 
SELECT empno,ename,job,hiredate,sal 
FROM emp;
-- 이름 , 부서번호 
SELECT ename,deptno
FROM emp;

-- 어떤 부서있는지 출력 ==> Set : 장르 , 음식종류 
SELECT DISTINCT deptno 
FROM emp;

-- SCOTT는 이번 급여가 3000입니다
SELECT ename||'는 이번 급여가 '||sal||'입니다'
FROM emp;
-- & 사용 => Scanner : 입력값을 받는다 
SELECT *
FROM emp
WHERE empno=&사번;

-- 별칭 ==> 오라클 
SELECT empno "사번",ename "이름",job "직위",hiredate "입사일"
FROM emp;
-- 별칭 ==> 자바 
SELECT empno as 사번,ename as 이름,job as 직위,hiredate as 입사일
FROM emp;
