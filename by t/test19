-- 입고 = 재고
/*
      품번 NUMBER,
      수량 NUMBER,
      금액 NUMBER
      INSERT INTO 입고 VALUES(100,5,1500)
         :NEW.품번 = 100
         :NEW.수량 = 5
         :NEW.금액 = 1500
*/
CREATE OR REPLACE TRIGGER 입고_Trigger
AFTER INSERT ON 입고
FOR EACH ROW
DECLARE
  v_cnt NUMBER;
BEGIN 
  SELECT COUNT(*) INTO v_cnt
  FROM 재고 
  WHERE 품번=:NEW.품번;
  
  IF (v_cnt=0) THEN -- 새로운 상품이 입고 
    INSERT INTO 재고 VALUES(:NEW.품번,:NEW.수량,:NEW.금액,:NEW.수량*:NEW.금액);
  ELSE  -- 기존에 있는 상품이 입고 
    UPDATE 재고 SET
    수량=수량+:NEW.수량,
    누적금액=누적금액+(:NEW.수량*:NEW.금액)
    WHERE 품번=:NEW.품번;
  END IF;
END;
/

CREATE OR REPLACE TRIGGER 출고_Trigger
AFTER INSERT ON 출고
FOR EACH ROW
DECLARE
  v_cnt NUMBER;
BEGIN
  SELECT 수량 INTO v_cnt
  FROM 재고
  WHERE 품번=:NEW.품번;
  
  IF (:NEW.수량=v_cnt) THEN
    DELETE FROM 재고
    WHERE 품번=:NEW.품번;
  ELSE
    UPDATE 재고 SET
    수량=수량-:NEW.수량,
    누적금액=누적금액-(:NEW.수량*:NEW.금액)
    WHERE 품번=:NEW.품번;
  END IF;
END;
/
-- 재고에 있는 상품 ==> 재고 (UPDATE)
-- 재고에 없는 상품 ==> 재고 (INSERT)
-- 출고 = 재고
-- 출고량 = 제고량  ==> 재고 (DELETE)
-- 출고량 != 재고량 ==> 재고 (UPDATE)
