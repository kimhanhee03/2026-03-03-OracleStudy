CREATE OR REPLACE FUNCTION dateChange(
  pEmpno emp.empno%TYPE
) RETURN VARCHAR2
IS 
  pDate VARCHAR2(30);
BEGIN
  SELECT TO_CHAR(hiredate,'YYYY-MM-DD HH24:MI:SS') INTO pDate
  FROM emp
  WHERE empno=pEmpno;
  RETURN pDate;
END;
/
